# Copy to .env.production. This real file is ignored by Git.
APP_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
TRAEFIK_NETWORK=docker_default
# Required: e.g. 192.168.4.0/24, using your actual desktop LAN subnet.
LAN_ALLOWED_CIDRS=
HOMEY_URL=
HOMEY_API_KEY=

# Explicit device mappings, copied from Homey IDs.
HOMEY_LIVING_LIGHT_ID=
HOMEY_LIVING_CLIMATE_ID=

# AI inventory analysis. Keep tokens private.
INVENTORY_AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_INVENTORY_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
CLOUDFLARE_INVENTORY_CONSOLIDATION_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Optional OpenAI fallback.
OPENAI_API_KEY=
OPENAI_INVENTORY_MODEL=gpt-5.6-terra
